{
  "name": "reinfolib-service",
  "private": true,
  "scripts": {
    "build": "esbuild src/app.ts --bundle --outfile=docs/app.js --target=es2017 --format=iife",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "esbuild src/app.ts --bundle --outfile=docs/app.js --target=es2017 --format=iife --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "happy-dom": "^17.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
